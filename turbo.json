{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "DATABASE_URL",
        "PREMBLY_ADAPTER_MODE",
        "PREMBLY_BASE_URL",
        "PREMBLY_API_KEY",
        "PREMBLY_APP_ID",
        "PAYSTACK_ADAPTER_MODE",
        "PAYSTACK_SECRET_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "DATABASE_URL",
        "PREMBLY_ADAPTER_MODE",
        "PREMBLY_BASE_URL",
        "PREMBLY_API_KEY",
        "PREMBLY_APP_ID",
        "PAYSTACK_ADAPTER_MODE",
        "PAYSTACK_SECRET_KEY"
      ]
    }
  }
}
