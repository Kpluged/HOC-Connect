# Driver app config (Expo public env — inlined into the client bundle).
# All values here are client-safe by design (anon key, pk Mapbox token,
# Sentry DSN). Copy to .env.local and fill in.

# Same Supabase project as the web app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The web app's tRPC HTTP endpoint (e.g. https://<app>.vercel.app/api/trpc,
# or http://localhost:3000/api/trpc for local dev).
EXPO_PUBLIC_TRPC_URL=

# Mapbox public token (same pk.* as the web app) for the native map.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Sentry DSN for the driver app (client-safe).
EXPO_PUBLIC_SENTRY_DSN=
