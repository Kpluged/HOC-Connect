# Supabase project URL and publishable (anon) key.
# Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never exposed to the browser, never committed.
# Dashboard -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Drizzle). Use the Transaction pooler
# connection string, port 6543.
# Dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL=

# Prembly KYC adapter. Defaults to "stub" (no real API calls, every
# application requires a manual HOC-staff decision) until real
# credentials exist and a live.ts adapter is implemented.
PREMBLY_ADAPTER_MODE=stub
PREMBLY_BASE_URL=
PREMBLY_API_KEY=
PREMBLY_APP_ID=

# Paystack payments adapter. Defaults to "stub" (initializeTransaction/
# verifyTransaction throw, verifyWebhookSignature always returns false)
# until real credentials exist and a live.ts adapter is implemented.
PAYSTACK_ADAPTER_MODE=stub
PAYSTACK_SECRET_KEY=

# Mapbox public access token (pk.*) for the Owner Space live dispatch map
# (Milestone 9). Public by design — it ships to the browser. Create one at
# account.mapbox.com. When absent, the map falls back to a static panel.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional. Extra allowed CORS origin for the Expo driver app's *web* build when
# hosted (localhost origins are always allowed for dev). Native apps send no
# Origin and don't need this. Bearer-auth only; CORS is granted without cookies.
DRIVER_WEB_ORIGIN=

# Sentry error monitoring. The DSN is client-safe (ships to the browser); when
# absent Sentry initialises disabled. The rest are build-time only and enable
# source-map upload during CI/Vercel builds — omit them and errors are still
# captured, just without symbolicated stack traces.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
